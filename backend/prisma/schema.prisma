// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────

enum Role {
  CUSTOMER
  COOK
  ADMIN
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum MealType {
  LUNCH
  DINNER
  BOTH
}

enum PlanType {
  FIVE_DAY
  TEN_MEAL
  TWENTY_DAY
  FLEXI
}

enum SubscriptionStatus {
  PENDING_PAYMENT
  ACTIVE
  PAUSED
  CANCELLED
  COMPLETED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  READY_FOR_PICKUP
  PICKED_UP
  DELIVERED
  CANCELLED
  COMPLETED
}

// ─────────────────────────────────────────────
// MODELS
// ─────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  fullName     String
  email        String   @unique
  phone        String?
  passwordHash String
  role         Role     @default(CUSTOMER)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  customerProfile CustomerProfile?
  cookProfile     CookProfile?

  // Orders as customer
  customerOrders Order[] @relation("CustomerOrders")

  // Subscriptions as customer
  customerSubscriptions Subscription[] @relation("CustomerSubscriptions")

  @@map("users")
}

model CustomerProfile {
  id                  String   @id @default(cuid())
  userId              String   @unique
  defaultAddress      String?
  dietaryPreferences  String[]
  allergies           String[]
  budgetRange         String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("customer_profiles")
}

model CookProfile {
  id                 String             @id @default(cuid())
  userId             String             @unique
  businessName       String
  bio                String?
  kitchenAddress     String?
  cuisineSpecialties String[]
  verificationStatus VerificationStatus @default(PENDING)
  maxMealsPerDay     Int                @default(50)
  rating             Float              @default(0.0)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  meals         Meal[]
  mealPlans     MealPlan[]
  cookOrders    Order[]        @relation("CookOrders")
  cookSubscriptions Subscription[] @relation("CookSubscriptions")

  @@map("cook_profiles")
}

model Meal {
  id            String   @id @default(cuid())
  cookId        String
  name          String
  description   String?
  cuisineType   String
  mealType      MealType @default(LUNCH)
  price         Float
  imageUrl      String?
  isAvailable   Boolean  @default(true)
  availableDays String[] // e.g. ["MONDAY","TUESDAY","WEDNESDAY","THURSDAY","FRIDAY"]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  cook     CookProfile @relation(fields: [cookId], references: [id], onDelete: Cascade)
  orders   Order[]
  mealPlans MealPlan[]

  @@map("meals")
}

model MealPlan {
  id          String   @id @default(cuid())
  cookId      String
  mealId      String?
  name        String
  description String?
  durationDays Int
  totalMeals  Int
  price       Float
  planType    PlanType @default(FIVE_DAY)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  cook          CookProfile    @relation(fields: [cookId], references: [id], onDelete: Cascade)
  meal          Meal?          @relation(fields: [mealId], references: [id])
  subscriptions Subscription[]

  @@map("meal_plans")
}

model Subscription {
  id           String             @id @default(cuid())
  customerId   String
  cookId       String
  mealPlanId   String
  startDate    DateTime
  endDate      DateTime
  status       SubscriptionStatus @default(PENDING_PAYMENT)
  totalPrice   Float
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  customer User        @relation("CustomerSubscriptions", fields: [customerId], references: [id])
  cook     CookProfile @relation("CookSubscriptions", fields: [cookId], references: [id])
  mealPlan MealPlan    @relation(fields: [mealPlanId], references: [id])
  orders   Order[]

  @@map("subscriptions")
}

model Order {
  id                  String      @id @default(cuid())
  subscriptionId      String?
  customerId          String
  cookId              String
  mealId              String?
  scheduledDate       DateTime
  mealType            MealType    @default(LUNCH)
  status              OrderStatus @default(PENDING)
  specialInstructions String?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  subscription Subscription? @relation(fields: [subscriptionId], references: [id])
  customer     User          @relation("CustomerOrders", fields: [customerId], references: [id])
  cook         CookProfile   @relation("CookOrders", fields: [cookId], references: [id])
  meal         Meal?         @relation(fields: [mealId], references: [id])

  @@map("orders")
}
